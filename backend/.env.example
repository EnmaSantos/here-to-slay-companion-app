BIND_ADDRESS=127.0.0.1:8080
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional. Without this, development rooms persist to SLAY_DATA_DIR.
# Use a Supabase session-pooler connection for this long-lived Rust service.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SLAY_DATA_DIR=backend/.slay-data
RUST_LOG=slay_server=info,tower_http=info
