{
  "name": "here-to-slay-online",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "dev:server": "cargo run --manifest-path backend/Cargo.toml",
    "test:engine": "cargo test --manifest-path backend/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "dev:all": "node scripts/dev.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.24.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-loading-skeleton": "3.5.0",
    "zustand": "^5.0.14",
    "motion": "14.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.3.1",
    "vite": "8.3.5",
    "wrangler": "4.152.0",
    "@cloudflare/workers-types": "5.20261026.1"
  },
  "type": "module",
  "overrides": {
    "undici": "7.30.1"
  }
}
